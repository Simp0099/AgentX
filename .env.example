# Never commit a real seed phrase, API key, or model artifact.
# Set both only in your shell or an uncommitted .env file.
AGENT_SEED_PHRASE=replace-with-a-long-random-private-seed-phrase
AGENTVERSE_API_KEY=replace-with-your-agentverse-api-key
CHECKPOINT=checkpoints/best_localizer.keras
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=24000000
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=15
INFERENCE_TIMEOUT_SECONDS=60
