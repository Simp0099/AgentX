# SMTP report delivery. For Gmail, use a 16-character app password from an
# account with 2-Step Verification enabled; never use a normal account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USERNAME=your-gmail-address@gmail.com
# SMTP_PASSWORD=your-16-character-google-app-password-without-spaces
# SMTP_FROM=your-gmail-address@gmail.com
# SMTP_STARTTLS=false
# For port 587, set SMTP_PORT=587 and SMTP_STARTTLS=true.
